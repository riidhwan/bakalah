CREATE TABLE library_manga_groups(
    _id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT
);

CREATE TABLE library_manga_group_members(
    group_id INTEGER NOT NULL REFERENCES library_manga_groups(_id) ON DELETE CASCADE,
    manga_id INTEGER NOT NULL REFERENCES mangas(_id) ON DELETE CASCADE,
    is_primary INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY(group_id, manga_id)
);

CREATE UNIQUE INDEX library_manga_group_members_manga_index
ON library_manga_group_members(manga_id);

CREATE UNIQUE INDEX library_manga_group_members_primary_index
ON library_manga_group_members(group_id)
WHERE is_primary = 1;
