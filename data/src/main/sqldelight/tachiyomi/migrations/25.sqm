DROP VIEW libraryView;

CREATE VIEW libraryView AS
WITH
active_groups AS (
    SELECT group_id
    FROM library_manga_group_members
    GROUP BY group_id
    HAVING count(*) >= 2
    AND sum(is_primary) = 1
),
member_chapter_stats AS (
    SELECT
        chapters.manga_id,
        count(*) AS total,
        sum(read) AS readCount,
        coalesce(max(chapters.date_upload), 0) AS latestUpload,
        coalesce(max(history.last_read), 0) AS lastRead,
        coalesce(max(chapters.date_fetch), 0) AS fetchedAt,
        sum(chapters.bookmark) AS bookmarkCount
    FROM chapters
    LEFT JOIN excluded_scanlators
    ON chapters.manga_id = excluded_scanlators.manga_id
    AND chapters.scanlator = excluded_scanlators.scanlator
    LEFT JOIN history
    ON chapters._id = history.chapter_id
    WHERE excluded_scanlators.scanlator IS NULL
    GROUP BY chapters.manga_id
),
library_chapter_stats AS (
    SELECT
        coalesce(AG.group_id, M._id) AS library_id,
        sum(coalesce(C.total, 0)) AS total,
        sum(coalesce(C.readCount, 0)) AS readCount,
        coalesce(max(C.latestUpload), 0) AS latestUpload,
        coalesce(max(C.lastRead), 0) AS lastRead,
        coalesce(max(C.fetchedAt), 0) AS fetchedAt,
        sum(coalesce(C.bookmarkCount, 0)) AS bookmarkCount
    FROM mangas M
    LEFT JOIN library_manga_group_members GM
    ON GM.manga_id = M._id
    LEFT JOIN active_groups AG
    ON AG.group_id = GM.group_id
    LEFT JOIN member_chapter_stats C
    ON C.manga_id = M._id
    WHERE M.favorite = 1
    GROUP BY coalesce(AG.group_id, M._id)
),
active_group_members AS (
    SELECT
        GM.group_id,
        group_concat(M._id) AS memberMangaIds,
        group_concat(M.source) AS memberSourceIds,
        group_concat(replace(M.title, ',', ' ')) AS memberTitles,
        group_concat(replace(coalesce(M.author, ''), ',', ' ')) AS memberAuthors,
        group_concat(replace(coalesce(M.artist, ''), ',', ' ')) AS memberArtists
    FROM library_manga_group_members GM
    JOIN active_groups AG
    ON AG.group_id = GM.group_id
    JOIN mangas M
    ON M._id = GM.manga_id
    WHERE M.favorite = 1
    GROUP BY GM.group_id
)
SELECT
    M.*,
    coalesce(C.total, 0) AS totalCount,
    coalesce(C.readCount, 0) AS readCount,
    coalesce(C.latestUpload, 0) AS latestUpload,
    coalesce(C.fetchedAt, 0) AS chapterFetchedAt,
    coalesce(C.lastRead, 0) AS lastRead,
    coalesce(C.bookmarkCount, 0) AS bookmarkCount,
    coalesce(MC.categories, '0') AS categories,
    AGM.group_id AS libraryGroupId,
    AGM.memberMangaIds,
    AGM.memberSourceIds,
    AGM.memberTitles,
    AGM.memberAuthors,
    AGM.memberArtists
FROM mangas M
LEFT JOIN library_manga_group_members GM
ON GM.manga_id = M._id
LEFT JOIN active_group_members AGM
ON AGM.group_id = GM.group_id
LEFT JOIN library_chapter_stats C
ON C.library_id = coalesce(AGM.group_id, M._id)
LEFT JOIN (
    SELECT manga_id, group_concat(category_id) AS categories
    FROM mangas_categories
    GROUP BY manga_id
) AS MC
ON MC.manga_id = M._id
WHERE M.favorite = 1
AND (AGM.group_id IS NULL OR GM.is_primary = 1);
