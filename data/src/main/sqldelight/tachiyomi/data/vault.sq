import kotlin.Boolean;
import tachiyomi.domain.vault.model.VaultCacheState;
import tachiyomi.domain.vault.model.VaultChapterContentFormat;
import tachiyomi.domain.vault.model.VaultMangaStatus;
import tachiyomi.domain.vault.model.VaultTransferState;
import tachiyomi.domain.vault.model.VaultTransferType;

CREATE TABLE content_vaults(
    _id INTEGER NOT NULL PRIMARY KEY,
    identity TEXT NOT NULL UNIQUE,
    display_name TEXT NOT NULL,
    layout_version INTEGER NOT NULL,
    root_revision_id TEXT NOT NULL,
    root_revision_number INTEGER NOT NULL,
    writer_id TEXT,
    last_catalogue_refresh_at INTEGER,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE vault_mangas(
    _id INTEGER NOT NULL PRIMARY KEY,
    vault_id INTEGER NOT NULL,
    identity TEXT NOT NULL,
    title TEXT NOT NULL,
    sort_key TEXT NOT NULL,
    author TEXT,
    artist TEXT,
    description TEXT,
    status INTEGER AS VaultMangaStatus NOT NULL,
    cover_id INTEGER,
    revision_id TEXT NOT NULL,
    revision_number INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(vault_id) REFERENCES content_vaults(_id) ON DELETE CASCADE,
    UNIQUE(vault_id, identity)
);

CREATE INDEX vault_mangas_vault_id_index ON vault_mangas(vault_id);
CREATE INDEX vault_mangas_sort_key_index ON vault_mangas(vault_id, sort_key);

CREATE TABLE vault_chapters(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    identity TEXT NOT NULL,
    title TEXT NOT NULL,
    chapter_number REAL NOT NULL,
    volume_number REAL,
    scanlator TEXT,
    source_order INTEGER NOT NULL,
    content_path TEXT NOT NULL,
    content_format INTEGER AS VaultChapterContentFormat NOT NULL,
    size_bytes INTEGER NOT NULL,
    checksum_sha256 TEXT NOT NULL,
    thumbnail_id INTEGER,
    revision_id TEXT NOT NULL,
    revision_number INTEGER NOT NULL,
    date_upload INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES vault_mangas(_id) ON DELETE CASCADE,
    UNIQUE(manga_id, identity)
);

CREATE INDEX vault_chapters_manga_id_index ON vault_chapters(manga_id);
CREATE INDEX vault_chapters_source_order_index ON vault_chapters(manga_id, source_order);

CREATE TABLE vault_labels(
    _id INTEGER NOT NULL PRIMARY KEY,
    vault_id INTEGER NOT NULL,
    identity TEXT NOT NULL,
    name TEXT NOT NULL,
    sort_key TEXT NOT NULL,
    is_sensitive INTEGER AS Boolean NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(vault_id) REFERENCES content_vaults(_id) ON DELETE CASCADE,
    UNIQUE(vault_id, identity)
);

CREATE INDEX vault_labels_vault_id_index ON vault_labels(vault_id, sort_key);

CREATE TABLE vault_manga_labels(
    manga_id INTEGER NOT NULL,
    label_id INTEGER NOT NULL,
    PRIMARY KEY(manga_id, label_id),
    FOREIGN KEY(manga_id) REFERENCES vault_mangas(_id) ON DELETE CASCADE,
    FOREIGN KEY(label_id) REFERENCES vault_labels(_id) ON DELETE CASCADE
);

CREATE TABLE vault_covers(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    identity TEXT NOT NULL,
    path TEXT NOT NULL,
    media_type TEXT,
    size_bytes INTEGER,
    checksum_sha256 TEXT,
    revision_id TEXT NOT NULL,
    revision_number INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(manga_id) REFERENCES vault_mangas(_id) ON DELETE CASCADE,
    UNIQUE(manga_id, identity)
);

CREATE INDEX vault_covers_manga_id_index ON vault_covers(manga_id);

CREATE TABLE vault_chapter_thumbnails(
    _id INTEGER NOT NULL PRIMARY KEY,
    chapter_id INTEGER NOT NULL,
    identity TEXT NOT NULL,
    path TEXT NOT NULL,
    media_type TEXT,
    size_bytes INTEGER,
    checksum_sha256 TEXT,
    revision_id TEXT NOT NULL,
    revision_number INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES vault_chapters(_id) ON DELETE CASCADE,
    UNIQUE(chapter_id, identity)
);

CREATE INDEX vault_chapter_thumbnails_chapter_id_index ON vault_chapter_thumbnails(chapter_id);

CREATE TABLE vault_reading_state(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    read INTEGER AS Boolean NOT NULL,
    bookmark INTEGER AS Boolean NOT NULL,
    last_page_read INTEGER NOT NULL,
    last_read_at INTEGER,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(chapter_id) REFERENCES vault_chapters(_id) ON DELETE CASCADE
);

CREATE TABLE vault_chapter_cache_state(
    chapter_id INTEGER NOT NULL PRIMARY KEY,
    state INTEGER AS VaultCacheState NOT NULL,
    local_path TEXT,
    size_bytes INTEGER,
    checksum_sha256 TEXT,
    last_verified_at INTEGER,
    last_opened_at INTEGER,
    updated_at INTEGER NOT NULL,
    failure_reason TEXT,
    FOREIGN KEY(chapter_id) REFERENCES vault_chapters(_id) ON DELETE CASCADE
);

CREATE INDEX vault_chapter_cache_state_state_index ON vault_chapter_cache_state(state);

CREATE TABLE vault_transfer_jobs(
    _id INTEGER NOT NULL PRIMARY KEY,
    vault_id INTEGER NOT NULL,
    manga_id INTEGER,
    chapter_id INTEGER,
    import_request_id INTEGER,
    operation_key TEXT,
    payload_json TEXT,
    type INTEGER AS VaultTransferType NOT NULL,
    state INTEGER AS VaultTransferState NOT NULL,
    remote_path TEXT,
    local_path TEXT,
    staged_path TEXT,
    size_bytes INTEGER,
    checksum_sha256 TEXT,
    failure_reason TEXT,
    added_count INTEGER NOT NULL DEFAULT 0,
    replaced_count INTEGER NOT NULL DEFAULT 0,
    failed_count INTEGER NOT NULL DEFAULT 0,
    cancelled_count INTEGER NOT NULL DEFAULT 0,
    detail_json TEXT,
    attempts INTEGER NOT NULL,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    started_at INTEGER,
    completed_at INTEGER,
    FOREIGN KEY(vault_id) REFERENCES content_vaults(_id) ON DELETE CASCADE,
    FOREIGN KEY(manga_id) REFERENCES vault_mangas(_id) ON DELETE SET NULL,
    FOREIGN KEY(chapter_id) REFERENCES vault_chapters(_id) ON DELETE SET NULL,
    FOREIGN KEY(import_request_id) REFERENCES vault_import_requests(_id) ON DELETE SET NULL
);

CREATE INDEX vault_transfer_jobs_vault_id_index ON vault_transfer_jobs(vault_id, state, updated_at);
CREATE INDEX vault_transfer_jobs_state_index ON vault_transfer_jobs(state, updated_at);
CREATE INDEX vault_transfer_jobs_manga_id_index ON vault_transfer_jobs(manga_id, state, updated_at);
CREATE INDEX vault_transfer_jobs_chapter_id_index ON vault_transfer_jobs(chapter_id);
CREATE INDEX vault_transfer_jobs_import_request_id_index ON vault_transfer_jobs(import_request_id);
CREATE INDEX vault_transfer_jobs_operation_key_index ON vault_transfer_jobs(operation_key, state, updated_at);

CREATE TABLE vault_import_target_hints(
    local_manga_id INTEGER NOT NULL PRIMARY KEY,
    local_manga_identity TEXT,
    content_vault_identity TEXT,
    source_identity TEXT,
    vault_manga_identity TEXT,
    vault_manga_id INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    FOREIGN KEY(vault_manga_id) REFERENCES vault_mangas(_id) ON DELETE CASCADE
);

CREATE TABLE vault_import_requests(
    _id INTEGER NOT NULL PRIMARY KEY,
    manga_id INTEGER NOT NULL,
    workflow TEXT NOT NULL,
    target_manga_id INTEGER,
    create_new_title TEXT,
    active_manga_identity TEXT,
    active_manifest_path TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE INDEX vault_import_requests_manga_id_index ON vault_import_requests(manga_id);

CREATE TABLE vault_import_request_chapters(
    request_id INTEGER NOT NULL,
    chapter_id INTEGER,
    selection_id TEXT NOT NULL,
    sort_order INTEGER NOT NULL,
    allow_replacement INTEGER AS Boolean NOT NULL,
    state TEXT NOT NULL DEFAULT 'pending',
    is_replaced INTEGER AS Boolean NOT NULL DEFAULT 0,
    failure_category TEXT,
    processed_at INTEGER,
    PRIMARY KEY(request_id, selection_id),
    FOREIGN KEY(request_id) REFERENCES vault_import_requests(_id) ON DELETE CASCADE
);

CREATE INDEX vault_import_request_chapters_request_id_index ON vault_import_request_chapters(request_id, sort_order);

CREATE TABLE vault_manifest_snapshots(
    _id INTEGER NOT NULL PRIMARY KEY,
    vault_id INTEGER NOT NULL,
    manga_id INTEGER,
    manifest_path TEXT NOT NULL,
    revision_id TEXT NOT NULL,
    revision_number INTEGER NOT NULL,
    body TEXT NOT NULL,
    fetched_at INTEGER NOT NULL,
    FOREIGN KEY(vault_id) REFERENCES content_vaults(_id) ON DELETE CASCADE,
    FOREIGN KEY(manga_id) REFERENCES vault_mangas(_id) ON DELETE CASCADE,
    UNIQUE(vault_id, manifest_path, revision_id)
);

getVaults:
SELECT *
FROM content_vaults
ORDER BY display_name;

getVaultByIdentity:
SELECT *
FROM content_vaults
WHERE identity = :identity;

upsertVault:
INSERT INTO content_vaults(
    _id, identity, display_name, layout_version, root_revision_id, root_revision_number, writer_id,
    last_catalogue_refresh_at, created_at, updated_at
)
VALUES (
    nullif(:id, -1), :identity, :displayName, :layoutVersion, :rootRevisionId, :rootRevisionNumber, :writerId,
    :lastCatalogueRefreshAt, :createdAt, :updatedAt
)
ON CONFLICT(identity) DO UPDATE SET
    display_name = excluded.display_name,
    layout_version = excluded.layout_version,
    root_revision_id = excluded.root_revision_id,
    root_revision_number = excluded.root_revision_number,
    writer_id = excluded.writer_id,
    last_catalogue_refresh_at = excluded.last_catalogue_refresh_at,
    updated_at = excluded.updated_at;

getMangaForVault:
SELECT *
FROM vault_mangas
WHERE vault_id = :vaultId
ORDER BY sort_key;

getMangaById:
SELECT *
FROM vault_mangas
WHERE _id = :id;

getMangaByIdentity:
SELECT *
FROM vault_mangas
WHERE vault_id = :vaultId
AND identity = :identity;

deleteMangaNotInIdentities:
DELETE FROM vault_mangas
WHERE vault_id = :vaultId
AND identity NOT IN :identities;

deleteMangaForVault:
DELETE FROM vault_mangas
WHERE vault_id = :vaultId;

deleteMangaById:
DELETE FROM vault_mangas
WHERE _id = :id;

upsertManga:
INSERT INTO vault_mangas(
    _id, vault_id, identity, title, sort_key, author, artist, description, status, cover_id,
    revision_id, revision_number, created_at, updated_at
)
VALUES (
    nullif(:id, -1), :vaultId, :identity, :title, :sortKey, :author, :artist, :description, :status, :coverId,
    :revisionId, :revisionNumber, :createdAt, :updatedAt
)
ON CONFLICT(vault_id, identity) DO UPDATE SET
    title = excluded.title,
    sort_key = excluded.sort_key,
    author = excluded.author,
    artist = excluded.artist,
    description = excluded.description,
    status = excluded.status,
    cover_id = excluded.cover_id,
    revision_id = excluded.revision_id,
    revision_number = excluded.revision_number,
    updated_at = excluded.updated_at;

getChaptersForManga:
SELECT
    vault_chapters._id,
    vault_chapters.manga_id,
    vault_chapters.identity,
    vault_chapters.title,
    vault_chapters.chapter_number,
    vault_chapters.volume_number,
    vault_chapters.scanlator,
    vault_chapters.source_order,
    vault_chapters.content_path,
    vault_chapters.content_format,
    vault_chapters.size_bytes,
    vault_chapters.checksum_sha256,
    vault_chapters.revision_id,
    vault_chapters.revision_number,
    vault_chapters.date_upload,
    vault_chapters.created_at,
    vault_chapters.updated_at,
    vault_chapter_thumbnails._id AS thumbnail_row_id,
    vault_chapter_thumbnails.identity AS thumbnail_identity,
    vault_chapter_thumbnails.path AS thumbnail_path,
    vault_chapter_thumbnails.media_type AS thumbnail_media_type,
    vault_chapter_thumbnails.size_bytes AS thumbnail_size_bytes,
    vault_chapter_thumbnails.checksum_sha256 AS thumbnail_checksum_sha256,
    vault_chapter_thumbnails.revision_id AS thumbnail_revision_id,
    vault_chapter_thumbnails.revision_number AS thumbnail_revision_number,
    vault_chapter_thumbnails.updated_at AS thumbnail_updated_at
FROM vault_chapters
LEFT JOIN vault_chapter_thumbnails ON vault_chapter_thumbnails._id = vault_chapters.thumbnail_id
WHERE manga_id = :mangaId
ORDER BY source_order;

getChaptersForVault:
SELECT
    vault_chapters._id,
    vault_chapters.manga_id,
    vault_chapters.identity,
    vault_chapters.title,
    vault_chapters.chapter_number,
    vault_chapters.volume_number,
    vault_chapters.scanlator,
    vault_chapters.source_order,
    vault_chapters.content_path,
    vault_chapters.content_format,
    vault_chapters.size_bytes,
    vault_chapters.checksum_sha256,
    vault_chapters.revision_id,
    vault_chapters.revision_number,
    vault_chapters.date_upload,
    vault_chapters.created_at,
    vault_chapters.updated_at,
    vault_chapter_thumbnails._id AS thumbnail_row_id,
    vault_chapter_thumbnails.identity AS thumbnail_identity,
    vault_chapter_thumbnails.path AS thumbnail_path,
    vault_chapter_thumbnails.media_type AS thumbnail_media_type,
    vault_chapter_thumbnails.size_bytes AS thumbnail_size_bytes,
    vault_chapter_thumbnails.checksum_sha256 AS thumbnail_checksum_sha256,
    vault_chapter_thumbnails.revision_id AS thumbnail_revision_id,
    vault_chapter_thumbnails.revision_number AS thumbnail_revision_number,
    vault_chapter_thumbnails.updated_at AS thumbnail_updated_at
FROM vault_chapters
JOIN vault_mangas ON vault_mangas._id = vault_chapters.manga_id
LEFT JOIN vault_chapter_thumbnails ON vault_chapter_thumbnails._id = vault_chapters.thumbnail_id
WHERE vault_mangas.vault_id = :vaultId
ORDER BY vault_mangas.sort_key, vault_chapters.source_order;

getChapterByIdentity:
SELECT *
FROM vault_chapters
WHERE manga_id = :mangaId
AND identity = :identity;

deleteChaptersNotInIdentities:
DELETE FROM vault_chapters
WHERE manga_id = :mangaId
AND identity NOT IN :identities;

deleteChaptersForManga:
DELETE FROM vault_chapters
WHERE manga_id = :mangaId;

upsertChapter:
INSERT INTO vault_chapters(
    _id, manga_id, identity, title, chapter_number, volume_number, scanlator, source_order,
    content_path, content_format, size_bytes, checksum_sha256, thumbnail_id, revision_id, revision_number,
    date_upload, created_at, updated_at
)
VALUES (
    nullif(:id, -1), :mangaId, :identity, :title, :chapterNumber, :volumeNumber, :scanlator, :sourceOrder,
    :contentPath, :contentFormat, :sizeBytes, :checksumSha256, NULL, :revisionId, :revisionNumber,
    :dateUpload, :createdAt, :updatedAt
)
ON CONFLICT(manga_id, identity) DO UPDATE SET
    title = excluded.title,
    chapter_number = excluded.chapter_number,
    volume_number = excluded.volume_number,
    scanlator = excluded.scanlator,
    source_order = excluded.source_order,
    content_path = excluded.content_path,
    content_format = excluded.content_format,
    size_bytes = excluded.size_bytes,
    checksum_sha256 = excluded.checksum_sha256,
    revision_id = excluded.revision_id,
    revision_number = excluded.revision_number,
    date_upload = excluded.date_upload,
    updated_at = excluded.updated_at;

updateChapterThumbnail:
UPDATE vault_chapters
SET thumbnail_id = :thumbnailId
WHERE _id = :chapterId;

upsertChapterThumbnail:
INSERT INTO vault_chapter_thumbnails(
    _id, chapter_id, identity, path, media_type, size_bytes, checksum_sha256, revision_id, revision_number, updated_at
)
VALUES (
    nullif(:id, -1), :chapterId, :identity, :path, :mediaType, :sizeBytes, :checksumSha256, :revisionId,
    :revisionNumber, :updatedAt
)
ON CONFLICT(chapter_id, identity) DO UPDATE SET
    path = excluded.path,
    media_type = excluded.media_type,
    size_bytes = excluded.size_bytes,
    checksum_sha256 = excluded.checksum_sha256,
    revision_id = excluded.revision_id,
    revision_number = excluded.revision_number,
    updated_at = excluded.updated_at;

getChapterThumbnailByIdentity:
SELECT *
FROM vault_chapter_thumbnails
WHERE chapter_id = :chapterId
AND identity = :identity;

deleteChapterThumbnailsNotInIdentities:
DELETE FROM vault_chapter_thumbnails
WHERE chapter_id = :chapterId
AND identity NOT IN :identities;

deleteChapterThumbnailsForChapter:
DELETE FROM vault_chapter_thumbnails
WHERE chapter_id = :chapterId;

getLabels:
SELECT *
FROM vault_labels
WHERE vault_id = :vaultId
ORDER BY sort_key;

getLabelsForVault:
SELECT *
FROM vault_labels
WHERE vault_id = :vaultId
ORDER BY sort_key;

getLabelsForManga:
SELECT vault_labels.*
FROM vault_labels
JOIN vault_manga_labels ON vault_manga_labels.label_id = vault_labels._id
WHERE vault_manga_labels.manga_id = :mangaId
ORDER BY vault_labels.sort_key;

getLabelsByMangaForVault:
SELECT vault_manga_labels.manga_id, vault_labels.*
FROM vault_manga_labels
JOIN vault_labels ON vault_labels._id = vault_manga_labels.label_id
JOIN vault_mangas ON vault_mangas._id = vault_manga_labels.manga_id
WHERE vault_mangas.vault_id = :vaultId
ORDER BY vault_mangas.sort_key, vault_labels.sort_key;

deleteLabelsNotInIdentities:
DELETE FROM vault_labels
WHERE vault_id = :vaultId
AND identity NOT IN :identities;

deleteLabelsForVault:
DELETE FROM vault_labels
WHERE vault_id = :vaultId;

upsertLabel:
INSERT INTO vault_labels(_id, vault_id, identity, name, sort_key, is_sensitive, created_at, updated_at)
VALUES (nullif(:id, -1), :vaultId, :identity, :name, :sortKey, :isSensitive, :createdAt, :updatedAt)
ON CONFLICT(vault_id, identity) DO UPDATE SET
    name = excluded.name,
    sort_key = excluded.sort_key,
    is_sensitive = excluded.is_sensitive,
    updated_at = excluded.updated_at;

deleteMangaLabels:
DELETE FROM vault_manga_labels
WHERE manga_id = :mangaId;

insertMangaLabel:
INSERT INTO vault_manga_labels(manga_id, label_id)
VALUES (:mangaId, :labelId);

upsertCover:
INSERT INTO vault_covers(
    _id, manga_id, identity, path, media_type, size_bytes, checksum_sha256, revision_id, revision_number, updated_at
)
VALUES (
    nullif(:id, -1), :mangaId, :identity, :path, :mediaType, :sizeBytes, :checksumSha256, :revisionId,
    :revisionNumber, :updatedAt
)
ON CONFLICT(manga_id, identity) DO UPDATE SET
    path = excluded.path,
    media_type = excluded.media_type,
    size_bytes = excluded.size_bytes,
    checksum_sha256 = excluded.checksum_sha256,
    revision_id = excluded.revision_id,
    revision_number = excluded.revision_number,
    updated_at = excluded.updated_at;

getCoverByIdentity:
SELECT *
FROM vault_covers
WHERE manga_id = :mangaId
AND identity = :identity;

getCoverForManga:
SELECT *
FROM vault_covers
WHERE manga_id = :mangaId
ORDER BY updated_at DESC
LIMIT 1;

deleteCoversNotInIdentities:
DELETE FROM vault_covers
WHERE manga_id = :mangaId
AND identity NOT IN :identities;

deleteCoversForManga:
DELETE FROM vault_covers
WHERE manga_id = :mangaId;

upsertReadingState:
INSERT INTO vault_reading_state(chapter_id, read, bookmark, last_page_read, last_read_at, updated_at)
VALUES (:chapterId, :read, :bookmark, :lastPageRead, :lastReadAt, :updatedAt)
ON CONFLICT(chapter_id) DO UPDATE SET
    read = excluded.read,
    bookmark = excluded.bookmark,
    last_page_read = excluded.last_page_read,
    last_read_at = excluded.last_read_at,
    updated_at = excluded.updated_at;

getReadingState:
SELECT *
FROM vault_reading_state
WHERE chapter_id = :chapterId;

upsertCacheState:
INSERT INTO vault_chapter_cache_state(
    chapter_id, state, local_path, size_bytes, checksum_sha256, last_verified_at, last_opened_at, updated_at,
    failure_reason
)
VALUES (
    :chapterId, :state, :localPath, :sizeBytes, :checksumSha256, :lastVerifiedAt, :lastOpenedAt, :updatedAt,
    :failureReason
)
ON CONFLICT(chapter_id) DO UPDATE SET
    state = excluded.state,
    local_path = excluded.local_path,
    size_bytes = excluded.size_bytes,
    checksum_sha256 = excluded.checksum_sha256,
    last_verified_at = excluded.last_verified_at,
    last_opened_at = excluded.last_opened_at,
    updated_at = excluded.updated_at,
    failure_reason = excluded.failure_reason;

getCacheState:
SELECT *
FROM vault_chapter_cache_state
WHERE chapter_id = :chapterId;

deleteCacheStates:
DELETE FROM vault_chapter_cache_state
WHERE chapter_id IN :chapterIds;

getCacheStatesForManga:
SELECT vault_chapter_cache_state.*
FROM vault_chapter_cache_state
JOIN vault_chapters ON vault_chapters._id = vault_chapter_cache_state.chapter_id
WHERE vault_chapters.manga_id = :mangaId;

getCacheStatesForVault:
SELECT vault_chapter_cache_state.*
FROM vault_chapter_cache_state
JOIN vault_chapters ON vault_chapters._id = vault_chapter_cache_state.chapter_id
JOIN vault_mangas ON vault_mangas._id = vault_chapters.manga_id
WHERE vault_mangas.vault_id = :vaultId;

getReadCacheStatesForVault:
SELECT vault_chapter_cache_state.*
FROM vault_chapter_cache_state
JOIN vault_chapters ON vault_chapters._id = vault_chapter_cache_state.chapter_id
JOIN vault_mangas ON vault_mangas._id = vault_chapters.manga_id
JOIN vault_reading_state ON vault_reading_state.chapter_id = vault_chapter_cache_state.chapter_id
WHERE vault_mangas.vault_id = :vaultId
AND vault_chapter_cache_state.state = :state
AND vault_reading_state.read = 1
ORDER BY
    coalesce(vault_chapter_cache_state.last_opened_at, vault_chapter_cache_state.last_verified_at, vault_chapter_cache_state.updated_at),
    vault_chapter_cache_state.chapter_id;

getLocalCacheUsageBytes:
SELECT coalesce(sum(vault_chapter_cache_state.size_bytes), 0)
FROM vault_chapter_cache_state
JOIN vault_chapters ON vault_chapters._id = vault_chapter_cache_state.chapter_id
JOIN vault_mangas ON vault_mangas._id = vault_chapters.manga_id
WHERE vault_mangas.vault_id = :vaultId
AND vault_chapter_cache_state.state = :state;

upsertImportTargetHint:
INSERT INTO vault_import_target_hints(
    local_manga_id, local_manga_identity, content_vault_identity, source_identity, vault_manga_identity,
    vault_manga_id, updated_at
)
VALUES (
    :localMangaId, :localMangaIdentity, :contentVaultIdentity, :sourceIdentity, :vaultMangaIdentity,
    :vaultMangaId, :updatedAt
)
ON CONFLICT(local_manga_id) DO UPDATE SET
    local_manga_identity = excluded.local_manga_identity,
    content_vault_identity = excluded.content_vault_identity,
    source_identity = excluded.source_identity,
    vault_manga_identity = excluded.vault_manga_identity,
    vault_manga_id = excluded.vault_manga_id,
    updated_at = excluded.updated_at;

getImportTargetHint:
SELECT *
FROM vault_import_target_hints
WHERE local_manga_id = :localMangaId;

getImportTargetHintAsFlow:
SELECT *
FROM vault_import_target_hints
WHERE local_manga_id = :localMangaId;

deleteImportTargetHint:
DELETE FROM vault_import_target_hints
WHERE local_manga_id = :localMangaId;

insertImportRequest:
INSERT INTO vault_import_requests(
    _id, manga_id, workflow, target_manga_id, create_new_title, active_manga_identity, active_manifest_path,
    created_at, updated_at
)
VALUES (
    nullif(:id, -1), :mangaId, :workflow, :targetMangaId, :createNewTitle, :activeMangaIdentity,
    :activeManifestPath, :createdAt, :updatedAt
);

lastInsertedImportRequestId:
SELECT last_insert_rowid();

insertImportRequestChapter:
INSERT INTO vault_import_request_chapters(
    request_id, chapter_id, selection_id, sort_order, allow_replacement, state, is_replaced, failure_category,
    processed_at
)
VALUES (
    :requestId, :chapterId, :selectionId, :sortOrder, :allowReplacement, :state, :isReplaced, :failureCategory,
    :processedAt
);

getImportRequest:
SELECT *
FROM vault_import_requests
WHERE _id = :id;

getImportRequestChapters:
SELECT *
FROM vault_import_request_chapters
WHERE request_id = :requestId
ORDER BY sort_order, selection_id;

updateImportRequestActiveTarget:
UPDATE vault_import_requests
SET active_manga_identity = :activeMangaIdentity,
    active_manifest_path = :activeManifestPath,
    updated_at = :updatedAt
WHERE _id = :id;

markImportRequestChapterCompleted:
UPDATE vault_import_request_chapters
SET state = 'completed',
    is_replaced = :isReplaced,
    failure_category = NULL,
    processed_at = :processedAt
WHERE request_id = :requestId
AND selection_id = :selectionId;

markImportRequestChapterFailed:
UPDATE vault_import_request_chapters
SET state = 'failed',
    is_replaced = 0,
    failure_category = :failureCategory,
    processed_at = :processedAt
WHERE request_id = :requestId
AND selection_id = :selectionId;

deleteImportRequest:
DELETE FROM vault_import_requests
WHERE _id = :id;

upsertManifestSnapshot:
INSERT INTO vault_manifest_snapshots(
    _id, vault_id, manga_id, manifest_path, revision_id, revision_number, body, fetched_at
)
VALUES (
    nullif(:id, -1), :vaultId, :mangaId, :manifestPath, :revisionId, :revisionNumber, :body, :fetchedAt
)
ON CONFLICT(vault_id, manifest_path, revision_id) DO UPDATE SET
    manga_id = excluded.manga_id,
    revision_number = excluded.revision_number,
    body = excluded.body,
    fetched_at = excluded.fetched_at;

getManifestSnapshot:
SELECT *
FROM vault_manifest_snapshots
WHERE vault_id = :vaultId
AND manifest_path = :manifestPath
AND revision_id = :revisionId;

getTransferJobsForVault:
SELECT *
FROM vault_transfer_jobs
WHERE vault_id = :vaultId
ORDER BY created_at, _id;

getTransferJobsForManga:
SELECT *
FROM vault_transfer_jobs
WHERE manga_id = :mangaId
OR chapter_id IN (
    SELECT _id
    FROM vault_chapters
    WHERE manga_id = :mangaId
)
ORDER BY created_at, _id;

deleteTransferJobsForManga:
DELETE FROM vault_transfer_jobs
WHERE manga_id = :mangaId
OR chapter_id IN (
    SELECT _id
    FROM vault_chapters
    WHERE manga_id = :mangaId
);

getActiveTransferJobsForOperationKey:
SELECT *
FROM vault_transfer_jobs
WHERE operation_key = :operationKey
AND state IN :states
ORDER BY created_at, _id;

getTransferJobsByState:
SELECT *
FROM vault_transfer_jobs
WHERE state IN :states
ORDER BY created_at, _id;

getTransferJob:
SELECT *
FROM vault_transfer_jobs
WHERE _id = :id;

upsertTransferJob:
INSERT INTO vault_transfer_jobs(
    _id, vault_id, manga_id, chapter_id, import_request_id, operation_key, payload_json,
    type, state, remote_path, local_path, staged_path, size_bytes,
    checksum_sha256, failure_reason, added_count, replaced_count, failed_count, cancelled_count, detail_json, attempts,
    created_at, updated_at, started_at, completed_at
)
VALUES (
    nullif(:id, -1), :vaultId, :mangaId, :chapterId, :importRequestId, :operationKey, :payloadJson,
    :type, :state, :remotePath, :localPath, :stagedPath,
    :sizeBytes, :checksumSha256, :failureReason, :addedCount, :replacedCount, :failedCount, :cancelledCount,
    :detailJson, :attempts, :createdAt, :updatedAt, :startedAt, :completedAt
)
ON CONFLICT(_id) DO UPDATE SET
    vault_id = excluded.vault_id,
    manga_id = excluded.manga_id,
    chapter_id = excluded.chapter_id,
    import_request_id = excluded.import_request_id,
    operation_key = excluded.operation_key,
    payload_json = excluded.payload_json,
    type = excluded.type,
    state = excluded.state,
    remote_path = excluded.remote_path,
    local_path = excluded.local_path,
    staged_path = excluded.staged_path,
    size_bytes = excluded.size_bytes,
    checksum_sha256 = excluded.checksum_sha256,
    failure_reason = excluded.failure_reason,
    added_count = excluded.added_count,
    replaced_count = excluded.replaced_count,
    failed_count = excluded.failed_count,
    cancelled_count = excluded.cancelled_count,
    detail_json = excluded.detail_json,
    attempts = excluded.attempts,
    updated_at = excluded.updated_at,
    started_at = excluded.started_at,
    completed_at = excluded.completed_at;

cancelInterruptedCaptureTransferJobsForImportRequest:
UPDATE vault_transfer_jobs
SET state = :state,
    failure_reason = :failureReason,
    updated_at = :updatedAt,
    completed_at = :completedAt
WHERE import_request_id = :importRequestId
AND type = :type
AND state = :runningState;

lastInsertedTransferJobId:
SELECT last_insert_rowid();
